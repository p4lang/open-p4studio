    Phv *ophv_out_got_136e0 = mau->process_action(iphv_in_136e0, ophv_in_136e0);
    
    EXPECT_TRUE( TestUtil::compare_phvs(ophv_out_got_136e0,ophv_out_136e0,false) );
    // this works for some tests, but not for others:
    //EXPECT_TRUE( TestUtil::compare_phvs(iphv_out_got_136e0,iphv_in_136e0,false) );
    RMT_UT_LOG_INFO("iphv_out_got %s iphv_in\n",
                    TestUtil::compare_phvs(iphv_out_got_136e0,iphv_in_136e0,false) ?
                    "==":"!=");
