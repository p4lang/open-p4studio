                // check the input to the selector alu
                MauLogicalRow *logrow = mau->logical_row_lookup(15);

                BitVector<RmtDefs::kDataBusWidth> data_in(UINT64_C(0));
      
                //logrow->stats_alu_rd_data(&data_in); 
                logrow->get_selector_alu_input_data(&data_in); 
                EXPECT_EQ( 0x00000000, data_in.get_word(0,  32));
                EXPECT_EQ( 0x00000000, data_in.get_word(32, 32));
                EXPECT_EQ( 0x00000000, data_in.get_word(64, 32));
                EXPECT_EQ( 0x00000000, data_in.get_word(96, 32));

