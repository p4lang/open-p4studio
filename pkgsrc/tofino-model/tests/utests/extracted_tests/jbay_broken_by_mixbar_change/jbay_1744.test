 ophv_out_9e1->set(267, 0x863b); 	/* [13, 7] N v=1  bytes:615-614  #9e1# Rtl-Output oPhv  */
 ophv_out_9e1->set(268, 0x682f); 	/* [13, 8] N v=1  bytes:617-616  #9e1# Rtl-Output oPhv  */
 ophv_out_9e1->set(269, 0x7815); 	/* [13, 9] N v=1  bytes:619-618  #9e1# Rtl-Output oPhv  */
 ophv_out_9e1->set(270, 0x0000); 	/* [13,10] N v=1  bytes:621-620  #9e1# Rtl-Output oPhv  */
 ophv_out_9e1->set(271, 0x0000); 	/* [13,11] N v=1  bytes:623-622  #9e1# Rtl-Output oPhv  */
 ophv_out_9e1->set(275, 0xae41); 	/* [13,15] M v=1  bytes:631-630  #9e1# Rtl-Output oPhv  */
 ophv_out_9e1->set(276, 0xabed); 	/* [13,16] D v=1  bytes:633-632  #9e1# Rtl-Output oPhv  */
 ophv_out_9e1->set(277, 0x2e06); 	/* [13,17] D v=1  bytes:635-634  #9e1# Rtl-Output oPhv  */
 ophv_out_9e1->set(278, 0x9025); 	/* [13,18] D v=1  bytes:637-636  #9e1# Rtl-Output oPhv  */
 ophv_out_9e1->set(279, 0x3c2f); 	/* [13,19] D v=1  bytes:639-638  #9e1# Rtl-Output oPhv  */
    int pred_ingress_next_table_9e1 = 0x1ff;
    int pred_egress_next_table_9e1 = 0x00c;
    int pred_ghost_next_table_9e1 = 0x1ff;
    // Next 2 calls setup PRED/MPR ingress_start_tab, egress_start_tab, ghost_start_tab, global_exec and long_branch.
    mau->set_pred(0x1ff, 0x00c, 0x1ff, 0x0000, 0x00); // i_nxt,e_nxt,g_nxt,gex,lbr
    mau->set_mpr(0x1ff, 0x00c, 0x1ff, 0x0000, 0x00); // i_nxt,e_nxt,g_nxt,gex,lbr
    Phv *iphv_out_got_9e1 = mau->process_match2(iphv_in_9e1, ophv_in_9e1,
						 &pred_ingress_next_table_9e1, &pred_egress_next_table_9e1, &pred_ghost_next_table_9e1);
    Phv *ophv_out_got_9e1 = mau->process_action(iphv_in_9e1, ophv_in_9e1);
    
    EXPECT_TRUE( TestUtil::compare_phvs(ophv_out_got_9e1,ophv_out_9e1,false) );
    // this works for some tests, but not for others:
    //EXPECT_TRUE( TestUtil::compare_phvs(iphv_out_got_9e1,iphv_in_9e1,false) );
    RMT_UT_LOG_INFO("iphv_out_got %s iphv_in\n",
                    TestUtil::compare_phvs(iphv_out_got_9e1,iphv_in_9e1,false) ?
                    "==":"!=");
